 for _,item in ipairs(fp)do assert(word(item[1])==item[2],"ROM differs")end
 add("ROM: "..#fp.."/"..#fp)
 local dc,ic=word(0x07ffc000),word(0x07ffa000)
 add("Cache D/I: "..((dc&1)==1 and"ON"or"OFF").."/"..((ic&1)==1 and"ON"or"OFF"))
 assert((dc&1)==1 and(ic&1)==1,"Cache state differs")
 -- Fresh long string + closed upvalue, no pointer/header modification.
 saved=keep(string.pack("<I4",0x7ffffffe)..string.rep("\0",124)..CODE..string.rep("\0",32))
 local up=ptr(debug.upvalueid(saved,1))
 local function inside(p,n)return type(p)=="number"and p%4==0 and p>lo and p+n<=hi end
 assert(inside(up,32),"Upvalue range differs")
 local value=word(up+8);assert(value==up+16,"Upvalue not closed")
 assert((word(value+8)&0xff)==0x54,"Value type differs")
 local obj=word(value);local length=#saved()
 assert(inside(obj,length+17),"String range differs")
 assert((word(obj+4)&0xff)==0x14 and word(obj+12)==length,"String layout differs")
 assert(word(obj+16)==0x7ffffffe and word(obj+144)==0xb802f000,"Payload differs")
 add("String: OK")
 lines={"Guard / ROM: OK","MPU / heap: OK","String: OK",
  "READY: tap screen once","Native has not run"}
 ready=true
 while not armed do paint();coroutine.yield("Waiting for RUN")end
 native_once(obj,length)
end
local co=coroutine.create(work)
timer=lvgl.Timer({period=100,cb=function()
 if not alive then return end
 local ok,why=coroutine.resume(co)
 if not ok then add("RESULT: NS1 CORE CHECK");add(tostring(why):sub(1,100)) end
 paint()
 if not ok or coroutine.status(co)=="dead"then
  saved=nil
  pcall(function()timer:pause()end)
  pcall(function()timer:delete()end)
 end
end})
root:add_flag(lvgl.FLAG.CLICKABLE)
root:onevent(lvgl.EVENT.CLICKED,function()
 if alive and ready and not armed then ready=false;armed=true end
end)
root:onevent(lvgl.EVENT.DELETE,function()
 alive=false;saved=nil
 if timer then pcall(function()timer:pause()end);pcall(function()timer:delete()end)end
end)
paint()
