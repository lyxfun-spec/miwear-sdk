       D.getinfo(saved, "S").what ~= "C" then
        return nil, "Recovered execute address mismatch"
    end
    rawset(old_os, "execute", saved)
    rawset(registry, STATE_KEY, {status = "recovered"})
    return saved, "Native execute restored; device test pending"
end

return M

end)()
local PROFILE = {
 target_id="xiaomi-band-11-nfc-4.100.179", identity_path="/etc/build.prop",
 firmware_version="4.100.179",firmware_build="user-4.100.179-cn-202609302100",
 lua_version="Lua 5.4",pmain=0x0c6d178c,pmain_error_handler=0x0c6cd0ac,
 os_execute=0x0c716140,io_open=0x0c715d68,
}
local function pointer(f)
 if type(f)~="function" then return nil end
 local h=tostring(f):match("^function:%s*0[xX](%x+)$") or tostring(f):match("^function:%s*(%x+)$")
 local p=h and tonumber(h,16);return p and p-p%2
end
local lines={}
local execute, original_open
local function add(s) lines[#lines+1]=s end
local function prepare()
 assert(type(io)=="table" and type(io.open)=="function","IO unavailable")
 assert(type(debug)=="table" and type(debug.getupvalue)=="function","debug unavailable")
 local _,f=debug.getupvalue(io.open,1)
 -- .179's path-checking Lua wrapper must retain the exact native opener.
 assert(pointer(f)==PROFILE.io_open,"IO fingerprint mismatch")
 original_open=f
 local profile,why=recovery.select_profile({[PROFILE.firmware_version]=PROFILE})
 assert(profile,why);add("Guard: OK")
 execute,why=recovery.recover(profile)
 assert(type(execute)=="function",why)
 add("Restore: OK")
 add("Exec: "..tostring(execute):gsub("^function:%s*",""))
end
local ok,err=pcall(prepare)
local prepared=ok
if not ok then add("RESULT: B12 STOP");add(tostring(err):sub(1,140)) end
-- B4: exact guarded cache maintenance and one synchronous owned native call.
local saved
local function keep(value) return function() return value end end
local function ptr(x)
 local h=tostring(x):match("0[xX](%x+)$") or tostring(x):match(":%s*(%x+)$")
 return h and tonumber(h,16)
end
local lvgl=require("lvgl")
local root=lvgl.Object(nil,{w=lvgl.HOR_RES(),h=lvgl.VER_RES(),bg_color=0x080e18,
 bg_opa=lvgl.OPA(100),border_width=0,pad_all=0})
pcall(function()root:clear_flag(lvgl.FLAG.SCROLLABLE)end)
local function label(text,y,h,size,color)
 local props={text=text,text_color=color,width=lvgl.HOR_RES()-18,height=h,
 align={type=lvgl.ALIGN.CENTER,x_ofs=0,y_ofs=y}}
 local ok,font=pcall(function()return lvgl.Font("MiSans-Regular",size)end)
 if ok and font then props.text_font=font end
 return lvgl.Label(root,props)
end
label("B11 NFC / NS1",-214,28,17,0x78ddf0)
label("Session core checks",-183,24,15,0xb7c8da)
local screen=label("Starting...",8,320,13,0xe5edf6)
local verdict=label("Tap screen: RUN once",194,24,13,0x78ddf0)
label("No BLE / no workers",222,20,11,0x8397ad)
-- B2's initialization report may contain a useful failure. Keep it on STOP.
if not prepared then screen:set{text=table.concat(lines,"\n")};return end
lines={"Guard / restore: OK"}
local alive,timer=true,nil
local ready,armed=false,false
local function paint()if alive then screen:set{text=table.concat(lines,"\n")}end end
local function progress(s)paint();coroutine.yield(s)end
local function word(address)
 assert(type(address)=="number" and address%4==0,"Unaligned read")
 progress("Read "..string.format("%08x",address))
 local path="/tmp/b11_ns1_word.txt"
 local f=assert(original_open(path,"wb"));assert(f:write("PENDING"));assert(f:close())
 local ok,ret=pcall(execute,string.format("mw %08x 4 > %s",address,path))
 assert(ok and(ret==true or ret==0),"MW command failed")
 f=assert(original_open(path,"rb"));local text=f:read(512)or"";f:close()
 local h=text:match("=%s*0[xX](%x+)")or text:match("%-%>%s*0[xX](%x+)")
 local v=h and tonumber(h,16)
 assert(v and v<=0xffffffff,"MW response: "..text:sub(1,70))
 return v
end
