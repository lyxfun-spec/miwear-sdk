local CODE=("@NATIVE_HEX@"):gsub("..",function(h)return string.char(tonumber(h,16))end)
local function native_once(object,length)
 local mailbox,code=object+16,object+144
 assert(length>=128+#CODE+32 and #CODE==@NATIVE_SIZE@,"Code size differs")
 local path="/tmp/b11_g1_exec.txt"
 local function put(address,value)
  assert(address==code+4 or address==mailbox+4,"Unexpected parameter write")
  local ok,r=pcall(execute,string.format("mw %08x=%08x > %s",address,value,path))
  assert(ok and(r==true or r==0),"Parameter write failed")
 end
 put(code+4,mailbox);assert(word(code+4)==mailbox,"Parameter readback failed")
 local executable=code-0x20000000
 assert(executable>=0x1c000000 and executable+#CODE<=0x1d000000,"Code alias differs")
 local function invoke(address,zero)
  local f=assert(original_open(path,"wb"));assert(f:write("PENDING"));assert(f:close())
  local ok,r=pcall(execute,string.format("exec 0x%08x > %s",address|1,path))
  f=assert(original_open(path,"rb"));local text=f:read(512)or"";f:close()
  local h=text:match("Calling%s+0[xX](%x+)")or text:match("Calling%s+(%x+)")
  assert(ok and h and(tonumber(h,16)&~1)==(address&~1),"Call not confirmed")
  if zero then assert(r==true or r==0,"Native return failed")end
 end
 local function report()
  local v={};for i=0,31 do v[i+1]=word(mailbox+i*4)end
  assert(v[1]==0x47340002,"Native report missing");return v
 end
 progress("Prepare G4R2 resident test")
 invoke(0x0c92e6da,true);invoke(0x0c91ca02,false);invoke(0x0c0c181e,true);invoke(0x0c91ca02,false)
 invoke(executable,false)
 local v=report()
 for i=1,48 do
  if v[31]~=0 or v[27]==1 or v[5]~=0 then break end
  lines={"G4R2 combined running","Case / passed: "..v[6].." / "..v[7],
   "Owners open/free: "..v[8].."/"..v[9],"Error: "..v[5],
   "Keep face awake", "Fixed bytes / PC peer"}
  progress("G4 poll "..i);put(mailbox+4,1);invoke(executable,false);v=report()
 end
 if v[27]~=1 then
  put(mailbox+4,2);invoke(executable,false)
  for i=1,8 do progress("Bounded cancel "..i);invoke(executable,false);v=report();if v[27]==1 then break end end
 end
 put(mailbox+4,3);invoke(executable,false);local d=report()
 local pass=v[5]==0 and v[6]==4 and v[7]==4 and v[8]==4 and v[9]==4 and v[10]==0 and v[11]==0
 pass=pass and v[12]==10 and v[13]==8 and v[14]>=9 and v[14]<=10 and v[15]==32 and v[16]==32
 pass=pass and v[17]==20 and v[18]==20 and v[19]==4 and v[20]==4 and v[21]==10
 pass=pass and v[22]==1 and v[23]==8 and v[24]==48 and v[25]==0 and v[26]==4 and v[27]==1
 pass=pass and v[28]>=20 and v[29]==0 and v[30]==0 and v[31]==0
 lines={"G4R2 SDK "..(pass and"PASS"or"CHECK"),"Cases passed/started: "..v[7].."/"..v[6],
  "Sessions open/destroy: "..v[8].."/"..v[9],"Live sessions/bytes: "..v[10].."/"..v[11],
  "Connect/disconnect rounds: "..v[12].."/"..v[13],"Read/write/notify: "..v[14].."/"..v[15].."/"..v[16],
  "Tokens created/collected: "..v[17].."/"..v[18],"Exit/join/barrier: "..v[20].."/"..v[19].."/"..v[21],
  "Expected ATT error: "..v[22],"Queue BUSY: "..v[23],
  "Callback UI/active: "..v[24].."/"..v[25],"Closed: "..v[26],"Quiet ticks: "..v[28],
  "Error: "..v[5],"Manager timer: "..(v[29]==0 and"STOPPED"or"LIVE"),
  "Fixed TX cap: 20","Module/runtime: HELD","Read cancel/code/h/n: "..d[25].."/"..d[23].."/"..(d[24]&65535).."/"..(d[24]>>16)}
 verdict:set{text="G4R2 SDK "..(pass and"PASS"or"CHECK")}
end
